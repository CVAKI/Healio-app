<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E53935"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚑 Nearby Ambulances"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLocationInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Searching nearby..."
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_alignParentBottom="true"
            android:alpha="0.9" />
    </RelativeLayout>

    <!-- Emergency Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🆘 Available ambulances are sorted by distance"
        android:textSize="12sp"
        android:textColor="#1976D2"
        android:background="#E3F2FD"
        android:padding="12dp"
        android:gravity="center" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- No Data Message -->
    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No ambulances available"
        android:textSize="16sp"
        android:textColor="#757575"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Ambulances List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAmbulances"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>